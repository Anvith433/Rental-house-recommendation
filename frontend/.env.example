# Only variables prefixed with VITE_ are exposed to browser code.
# Never put secrets (SECRET_KEY, JWT keys, database passwords) here.

# Base URL for API calls. Leave as /api when the frontend and API share an
# origin (Vite dev proxy or the bundled nginx).
VITE_API_BASE_URL=/api

# Dev-server only (not exposed to the browser): where Vite proxies /api.
API_PROXY_TARGET=http://localhost:8000
