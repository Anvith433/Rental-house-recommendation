# Copy to .env and fill in real values. Never commit .env.
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django -------------------------------------------------------------
DJANGO_SECRET_KEY=
# Optional separate JWT signing key (defaults to DJANGO_SECRET_KEY).
JWT_SIGNING_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Origins allowed to call the API cross-origin (not needed when the
# frontend is served from the same origin, as in docker-compose).
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://localhost:8080
LOG_LEVEL=INFO
API_DOCS_ENABLED=True

# --- Database ---------------------------------------------------------
# docker-compose builds DATABASE_URL from these values.
POSTGRES_DB=rentwise
POSTGRES_USER=rentwise
POSTGRES_PASSWORD=
# For running Django outside Docker:
# DATABASE_URL=postgres://rentwise:<password>@localhost:5432/rentwise

# --- HTTPS ------------------------------------------------------------
# Keep True in any real deployment behind TLS. The local docker-compose
# stack runs on plain HTTP at http://localhost:8080, so set both to False there.
SECURE_SSL_REDIRECT=False
SECURE_COOKIES=False
SECURE_HSTS_SECONDS=31536000

# --- JWT --------------------------------------------------------------
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# --- Rate limits (DRF format: <count>/<second|minute|hour|day>) --------
THROTTLE_ANON=300/hour
THROTTLE_USER=3000/hour
THROTTLE_AUTH=10/minute
THROTTLE_REFRESH=120/minute
THROTTLE_REGISTER=20/hour
THROTTLE_RECOMMENDATIONS=30/minute
THROTTLE_CONTACT=10/hour

# --- Demo data ----------------------------------------------------------
# SEED_ON_START=true seeds listings and demo accounts on container start.
SEED_ON_START=false
# Password for demo accounts created by `seed_data --demo-users`
# (a random one is generated and printed if unset).
SEED_DEMO_PASSWORD=
